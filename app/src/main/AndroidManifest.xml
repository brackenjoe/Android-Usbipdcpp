<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USB权限 -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- Fork: no camera and no microphone permission, and none may be added. A
         USB video-class device cannot be shared; the app says so. -->

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fork: ConnectivityManager, to find the VPN network the dial is bound to.
         A normal permission, granted at install -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fork: a partial wake lock while dial-out loops run, so the CPU keeps
         redialing with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Fork: the fingerprint prompt that opens the app and the dial key's window -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- androidx.biometric's own manifest adds USE_FINGERPRINT, which only the
         pre-API-28 fingerprint path needs; minSdk is 28 -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Usbipdcpp">
        <!-- singleTask：USB 权限对话框点"允许"后，系统会向声明了 device_filter 的
             本 Activity 投递 USB_DEVICE_ATTACHED intent；standard 模式会新建实例
             压栈（观感像 Activity 重建、返回键要按两次），singleTask 让 intent 送到
             既有实例（onNewIntent），全 app 保持单实例 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Usbipdcpp"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- USB设备附加意图 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <service
            android:name=".UsbService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="usbip_server" />
        </service>

        <!-- 自动存储语言设置 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>