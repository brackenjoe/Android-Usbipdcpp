<?xml version="1.0" encoding="utf-8"?>
<!--
   Fork: nothing is backed up (this file applies to API 30 and below, and to
   Android 12+ only when the app targets API 30 or lower; data_extraction_rules.xml
   covers the rest). allowBackup is false in the manifest as well.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
